# Скопируй в .env (прод) или .env.staging (тест) и заполни значения.
# Файлы .env / .env.staging не коммитятся.

BOT_TOKEN=
OWNER_ID=
TIMEZONE=Europe/Prague

# Юзернейм бота с @ (для кнопки «Скопировать»)
# Прод:  @delete_message_monitor_bot
# Тест:  @your_staging_bot
BOT_USERNAME=@delete_message_monitor_bot

# Опционально: TTL сообщений в RAM (секунды), по умолчанию 3 часа
# MESSAGE_TTL_SECONDS=10800
# CLEANUP_INTERVAL_SECONDS=120
